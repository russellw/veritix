# Supply-chain hardening. See docs/frontend-stack.md.
#
# NOTE: frozen-lockfile=true needs an existing pnpm-lock.yaml. To regenerate the
# lockfile from scratch, bootstrap once with:
#     corepack pnpm install --no-frozen-lockfile
# After that the committed lockfile is the source of truth and installs are frozen.
frozen-lockfile=true
prefer-frozen-lockfile=true

# A peer dependency that is not written down is a dependency nobody reviewed.
auto-install-peers=false
strict-peer-dependencies=true

# Belt and braces on top of pnpm's own default: lifecycle scripts are attacker
# code running at install time, on this machine and on CI.
ignore-scripts=true

# Dependency-confusion guard: resolve from npmjs and nowhere else.
registry=https://registry.npmjs.org/
